$date
	Mon May 25 06:07:48 2026
$end
$version
	ModelSim Version 2020.1
$end
$timescale
	1ps
$end

$scope module tb_Simple_MMSS_Timer $end
$var parameter 32 ! ONE_SEC $end
$var reg 1 " clk $end
$var reg 2 # timer_ctrl [1:0] $end
$var reg 7 $ seg_min_tens [6:0] $end
$var reg 7 % seg_min_units [6:0] $end
$var reg 7 & seg_sec_tens [6:0] $end
$var reg 7 ' seg_sec_units [6:0] $end

$scope task wait_seconds $end
$var integer 32 ( n $end
$upscope $end

$scope task apply_ctrl $end
$var reg 2 ) c [1:0] $end
$upscope $end

$scope task print_time $end
$upscope $end

$scope module dut $end
$var parameter 32 * CLK_FREQ $end
$var wire 1 + clk $end
$var wire 1 , timer_ctrl [1] $end
$var wire 1 - timer_ctrl [0] $end
$var reg 7 . seg_min_tens [6:0] $end
$var reg 7 / seg_min_units [6:0] $end
$var reg 7 0 seg_sec_tens [6:0] $end
$var reg 7 1 seg_sec_units [6:0] $end
$var reg 2 2 timer_status [1:0] $end
$var reg 1 3 rst $end
$var reg 1 4 en $end
$var reg 1 5 pulse_1hz $end
$var reg 1 6 sec_carry $end
$var reg 4 7 sec_units [3:0] $end
$var reg 4 8 sec_tens [3:0] $end
$var reg 4 9 min_units [3:0] $end
$var reg 4 : min_tens [3:0] $end

$scope module ctrl_unit $end
$var wire 1 + clk $end
$var wire 1 , timer_ctrl [1] $end
$var wire 1 - timer_ctrl [0] $end
$var reg 1 ; rst $end
$var reg 1 < en $end
$var reg 2 = timer_status [1:0] $end
$var reg 2 > state [1:0] $end
$upscope $end

$scope module clk_div $end
$var parameter 32 ? CLK_FREQ $end
$var wire 1 + clk $end
$var wire 1 @ rst $end
$var wire 1 A en $end
$var reg 1 B pulse_1hz $end
$var reg 4 C count [3:0] $end
$upscope $end

$scope module sec_cnt $end
$var wire 1 + clk $end
$var wire 1 D rst $end
$var wire 1 E en $end
$var wire 1 F pulse_1hz $end
$var reg 4 G sec_units [3:0] $end
$var reg 4 H sec_tens [3:0] $end
$var reg 1 I carry $end
$upscope $end

$scope module min_cnt $end
$var wire 1 + clk $end
$var wire 1 J rst $end
$var wire 1 K en $end
$var wire 1 L carry_in $end
$var reg 4 M min_units [3:0] $end
$var reg 4 N min_tens [3:0] $end
$upscope $end

$scope module su $end
$var wire 1 O bcdInput [3] $end
$var wire 1 P bcdInput [2] $end
$var wire 1 Q bcdInput [1] $end
$var wire 1 R bcdInput [0] $end
$var reg 7 S segOutput [6:0] $end
$upscope $end

$scope module st $end
$var wire 1 T bcdInput [3] $end
$var wire 1 U bcdInput [2] $end
$var wire 1 V bcdInput [1] $end
$var wire 1 W bcdInput [0] $end
$var reg 7 X segOutput [6:0] $end
$upscope $end

$scope module mu $end
$var wire 1 Y bcdInput [3] $end
$var wire 1 Z bcdInput [2] $end
$var wire 1 [ bcdInput [1] $end
$var wire 1 \ bcdInput [0] $end
$var reg 7 ] segOutput [6:0] $end
$upscope $end

$scope module mt $end
$var wire 1 ^ bcdInput [3] $end
$var wire 1 _ bcdInput [2] $end
$var wire 1 ` bcdInput [1] $end
$var wire 1 a bcdInput [0] $end
$var reg 7 b segOutput [6:0] $end
$upscope $end
$upscope $end
$upscope $end
$enddefinitions $end
